{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "api/**",
        "public/**"
      ]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:smoke": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "lint:fix": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
