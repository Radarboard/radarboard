# ===========================================
# MCP Server Environment Variables
# ===========================================
# Used by MCP servers configured in opencode.json

# RevenueCat API v2 Secret Key (used by RevenueCat MCP)
REVENUECAT_API_V2_SECRET_KEY=

# OpenPanel - goshuin.com (used by openpanel-goshuin MCP)
# Get from: OpenPanel dashboard > Settings > Projects > Create client (Root type)
OPENPANEL_GOSHUIN_COM_CLIENT_ID=
OPENPANEL_GOSHUIN_COM_CLIENT_SECRET=

# OpenPanel - goshuinatlas.com (used by openpanel-goshuinatlas MCP)
OPENPANEL_GOSHUINATLAS_COM_CLIENT_ID=
OPENPANEL_GOSHUINATLAS_COM_CLIENT_SECRET=
