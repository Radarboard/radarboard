{
  "name": "radarboard",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && pnpm check:modal-contract && pnpm check:route-error-responses && pnpm check:route-zod-boundaries",
    "lint:fix": "biome check --write . && pnpm check:modal-contract && pnpm check:route-error-responses && pnpm check:route-zod-boundaries",
    "spellcheck": "cspell --config .cspell.json --no-progress --gitignore \"**/*.{md,yml,yaml}\"",
    "spellcheck:staged": "cspell --config .cspell.json --no-progress --gitignore",
    "changeset": "pnpm exec changeset add",
    "changeset:add": "pnpm exec changeset add",
    "changeset:status": "pnpm exec changeset status --since=main",
    "changeset:check": "pnpm exec tsx scripts/check-changesets.ts --since=origin/main",
    "changeset:version": "pnpm exec tsx scripts/version-and-prepare-release-notes.ts",
    "release:notes": "pnpm exec tsx scripts/release-notes.ts",
    "release:notes:generate": "pnpm exec tsx scripts/generate-release-notes.ts",
    "release:notes:check": "pnpm exec tsx scripts/check-release-notes.ts",
    "release:homebrew:cask": "pnpm exec tsx scripts/update-homebrew-cask.ts",
    "release:desktop": "cp release-notes/_desktop-next-template.md release-notes/desktop-next.md",
    "release:desktop:prepare": "pnpm exec tsx scripts/prepare-desktop-release.ts",
    "release:desktop:alpha": "pnpm exec tsx scripts/prepare-desktop-release.ts alpha",
    "release:desktop:beta": "pnpm exec tsx scripts/prepare-desktop-release.ts beta",
    "release:desktop:stable": "pnpm exec tsx scripts/prepare-desktop-release.ts stable",
    "release:desktop:dry-run": "pnpm exec tsx scripts/prepare-desktop-release.ts dry-run",
    "release:desktop:info": "pnpm exec tsx scripts/desktop-release-info.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:staged:related": "pnpm exec tsx scripts/run-related-vitest.ts",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:smoke": "turbo run test:e2e:smoke",
    "react-doctor": "pnpm exec tsx scripts/react-doctor.ts",
    "react-doctor:strict": "pnpm react-doctor --fail-on warning",
    "format": "biome format --write .",
    "check:app-alias-imports": "pnpm exec tsx scripts/check-app-alias-imports.ts",
    "check:badge-contract": "pnpm exec tsx scripts/check-badge-contract.ts",
    "check:button-contract": "pnpm exec tsx scripts/check-button-contract.ts",
    "check:form-controls-contract": "pnpm exec tsx scripts/check-form-controls-contract.ts",
    "check:modal-contract": "pnpm exec tsx scripts/check-modal-contract.ts",
    "check:story-authenticity": "pnpm exec tsx scripts/check-story-authenticity.ts",
    "check:tooltip-contract": "pnpm exec tsx scripts/check-tooltip-contract.ts",
    "schema:docs": "tsx scripts/generate-schema-docs.ts",
    "schema:check": "tsx scripts/generate-schema-docs.ts --check",
    "knip": "knip --no-config-hints",
    "knip:fix": "knip --fix",
    "dev:desktop": "turbo run dev --filter=@radarboard/desktop",
    "dev:ios": "turbo run ios:dev --filter=@radarboard/desktop",
    "build:ios": "turbo run ios:build --filter=@radarboard/desktop",
    "build:desktop": "turbo run build:desktop --filter=@radarboard/desktop",
    "desktop:build:dev-app": "pnpm --filter @radarboard/desktop build:dev-app",
    "desktop:link:dev-app": "pnpm --filter @radarboard/desktop link:dev-app",
    "desktop:unlink:dev-app": "pnpm --filter @radarboard/desktop unlink:dev-app",
    "clean": "rm -rf apps/app/.next apps/docs/.mintlify .turbo node_modules/.cache && find . -name '.turbo' -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; echo 'Cleaned build caches'",
    "clean:all": "pnpm clean && find . -name 'node_modules' -type d -prune -exec rm -rf {} + 2>/dev/null; echo 'Cleaned everything — run pnpm install'",
    "generate:extensions": "tsx scripts/generate-extensions-init.ts",
    "create-widget": "tsx scripts/create-widget.ts",
    "create-integration": "tsx scripts/create-integration.ts",
    "create-plugin": "tsx scripts/create-plugin.ts",
    "generate-agents-md": "tsx scripts/generate-agents-md.ts",
    "check:extensions": "tsx scripts/check-extensions-quality.ts",
    "check:jsdoc": "tsx scripts/check-jsdoc-coverage.ts",
    "check:ui-consistency": "tsx scripts/check-ui-consistency.ts",
    "measure:dx": "tsx scripts/measure-dx.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:modularity": "tsx scripts/check-modularity.ts",
    "check:app-structure": "tsx scripts/check-app-structure.ts",
    "check:app-ownership": "tsx scripts/check-app-ownership.ts",
    "check:api-route-literals": "tsx scripts/check-api-route-literals.ts",
    "check:route-error-responses": "tsx scripts/check-route-error-responses.ts",
    "check:route-zod-boundaries": "tsx scripts/check-route-zod-boundaries.ts",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix-mismatches",
    "deps:format": "syncpack format",
    "secrets": "secretlint \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,env}\"",
    "secrets:staged": "secretlint",
    "publint": "publint packages/create-extension",
    "scaffold:extension-repo": "tsx scripts/scaffold-extension-repo.ts",
    "docs:sdk": "tsx scripts/generate-sdk-docs.ts",
    "docs:sdk:check": "tsx scripts/generate-sdk-docs.ts --check",
    "test:extensions": "turbo run test --filter='./integrations/*' --filter='./plugins/*' --filter='./widgets/*'",
    "catalog:generate": "tsx scripts/generate-extension-catalog.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.7",
    "cspell": "^9.8.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "lefthook": "^2.1.9",
    "publint": "^0.3.21",
    "secretlint": "^11.7.1",
    "syncpack": "^14.3.1",
    "ts-morph": "^27.0.2",
    "tsc-files": "^1.1.4",
    "tsx": "^4.22.3",
    "turbo": "^2.9.16",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "puppeteer",
      "sharp"
    ]
  },
  "dependencies": {
    "next-themes": "^0.4.6"
  }
}
