{
  "name": "@radarboard/storybook",
  "private": true,
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "tsx scripts/generate-stories.ts && storybook dev -p 6006 --config-dir .storybook",
    "build": "tsx scripts/generate-stories.ts && storybook build --config-dir .storybook -o dist",
    "build-storybook": "tsx scripts/generate-stories.ts && storybook build --config-dir .storybook -o dist",
    "build:chromatic": "tsx scripts/generate-stories.ts && chromatic deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "generate:stories": "tsx scripts/generate-stories.ts"
  },
  "dependencies": {
    "@fontsource-variable/chivo-mono": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inconsolata": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@radarboard/assistant-ui": "workspace:*",
    "@radarboard/charts": "workspace:*",
    "@radarboard/hooks": "workspace:*",
    "@radarboard/themes": "workspace:*",
    "@radarboard/types": "workspace:*",
    "@radarboard/ui": "workspace:*",
    "@radarboard/utils": "workspace:*",
    "@radarboard/widget-engine": "workspace:*",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/nextjs-vite": "^10.3.1",
    "geist": "^1.7.0",
    "lucide-react": "catalog:",
    "next": "^16.2.1",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.7",
    "storybook": "^10.3.1",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@radarboard/tsconfig": "workspace:*",
    "@storybook/addon-mcp": "^0.4.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chromatic": "^16.0.0",
    "tsx": "^4.21.0",
