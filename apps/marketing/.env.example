# ===========================================
# Radarboard Marketing — Environment Variables
# ===========================================

# --- OpenPanel Client-Side Tracking ---
# Public client ID for browser-side analytics (pageviews, events)
# Get from: OpenPanel dashboard > Settings > Clients
NEXT_PUBLIC_OPENPANEL_MARKETING_CLIENT_ID=

# --- Resend (Waitlist) ---
# API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Audience ID from: Resend dashboard > Audiences
RESEND_AUDIENCE_ID=
# Verified sender address (e.g., hello@radarboard.com)
RESEND_FROM_EMAIL=
