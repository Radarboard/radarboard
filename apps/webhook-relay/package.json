{
  "name": "@radarboard/apphook-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env.local src/dev-server.ts",
    "build": "node scripts/build-vercel.mjs && tsc --noEmit",
    "build:standalone": "node scripts/build-standalone.mjs && tsc --noEmit",
    "build:cloudflare": "node scripts/build-cloudflare.mjs && tsc --noEmit",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radarboard/integration-betterstack": "workspace:*",
    "@radarboard/integration-github": "workspace:*",
    "@radarboard/integration-linear": "workspace:*",
    "@radarboard/integration-sdk": "workspace:*",
    "@radarboard/integration-sentry": "workspace:*",
    "@radarboard/integration-vercel": "workspace:*",
    "@radarboard/types": "workspace:*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@hono/node-server": "^1.15.1",
    "@radarboard/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "^0.27.4",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
