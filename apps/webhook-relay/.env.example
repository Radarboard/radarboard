# ===========================================
# Webhook Relay - Environment Variables
# ===========================================
# Deploy to Vercel, Railway, Fly.io, Render, or any platform.
# See docs: apps/docs/developer-guide/webhook-relay.mdx

# --- Store Mode ---
# Set to "memory" to run without Redis (events lost on restart).
# Default: uses Upstash Redis (requires KV_REST_API_URL + KV_REST_API_TOKEN).
# RELAY_STORE=memory

# --- Upstash Redis ---
# Not required when RELAY_STORE=memory.
# Get from: https://console.upstash.com/
# On Vercel, auto-provisioned by the Vercel KV integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Poll Authentication ---
# Shared secret the local dashboard uses to authenticate poll requests.
# Generate with: openssl rand -hex 32
RELAY_POLL_SECRET=

# --- Webhook Secrets (per integration) ---
# Only set secrets for integrations you use.
# Supports comma-separated values for zero-downtime rotation.
# WEBHOOK_SECRET_GITHUB=
# WEBHOOK_SECRET_VERCEL=
# WEBHOOK_SECRET_SENTRY=
# WEBHOOK_SECRET_LINEAR=
# WEBHOOK_SECRET_BETTERSTACK=

# --- Multi-Tenant (managed relay) ---
# Admin secret for tenant provisioning API (/api/tenants).
# Only needed for managed deployments (e.g. relay.radarboard.app).
# Generate with: openssl rand -hex 32
# RELAY_ADMIN_SECRET=

# --- Optional ---
# Sentry DSN for error monitoring of the relay itself
# SENTRY_DSN=
# Restrict CORS on poll endpoint (not needed for server-to-server polling)
# ALLOWED_ORIGIN=
# Global kill switch — set to "false" to disable all webhook ingestion
# RELAY_ENABLED=true
