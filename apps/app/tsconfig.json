{
  "extends": "@radarboard/tsconfig/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/components/*": ["./components/*", "./components/system/*"],
      "@/hooks/*": [
        "./hooks/*",
        "./hooks/app/*",
        "./hooks/dashboard/*",
        "./hooks/desktop/*",
        "./hooks/plugins/*",
        "./hooks/projects/*",
        "./hooks/settings/*",
        "./modules/settings/store/*"
      ],
      "@/db/*": [
        "./data/*",
        "./data/core/*",
        "./data/cache/*",
        "./data/credentials/*",
        "./data/debug/*",
        "./data/extensions/*",
        "./data/llm/*",
        "./data/settings/*",
        "./data/providers/sqlite/*"
      ],
      "@/data/*": [
        "./data/*",
        "./data/core/*",
        "./data/cache/*",
        "./data/credentials/*",
        "./data/debug/*",
        "./data/extensions/*",
        "./data/llm/*",
        "./data/settings/*",
        "./data/providers/sqlite/*"
      ],
      "@/lib/api": ["./lib/utils/core/api.ts"],
      "@/lib/assistant-context-cache": ["./lib/assistant/core/assistant-context-cache.ts"],
      "@/lib/assistant-route-runtime": ["./lib/assistant/core/assistant-route-runtime.ts"],
      "@/lib/ai-tools": ["./lib/assistant/core/ai-tools.ts"],
      "@/lib/auto-embed": ["./lib/assistant/integration/auto-embed.ts"],
      "@/lib/backup-tasks": ["./lib/assistant/integration/backup-tasks.ts"],
      "@/lib/conversation-extractor": ["./lib/assistant/knowledge/conversation-extractor.ts"],
      "@/lib/credential-resolver": ["./lib/assistant/integration/credential-resolver.ts"],
      "@/lib/data-source-context": ["./lib/assistant/core/data-source-context.ts"],
      "@/lib/embedding-service-singleton": ["./lib/assistant/core/embedding-service-singleton.ts"],
      "@/lib/knowledge-health": ["./lib/assistant/knowledge/knowledge-health.ts"],
      "@/lib/memory-service": ["./lib/assistant/knowledge/memory-service.ts"],
      "@/lib/plugin-tool-bridge": ["./lib/assistant/core/plugin-tool-bridge.ts"],
      "@/lib/changelog-server": ["./lib/integrations/content/changelog-server.ts"],
      "@/lib/integration-artifacts": ["./lib/integrations/config/integration-artifacts.ts"],
      "@/lib/integration-connections": ["./lib/integrations/config/integration-connections.ts"],
      "@/lib/integration-data-invalidation": [
        "./lib/integrations/config/integration-data-invalidation.ts"
      ],
      "@/lib/integration-rss-feeds": ["./lib/integrations/content/integration-rss-feeds.ts"],
      "@/lib/integration-status-pages": ["./lib/integrations/status/integration-status-pages.ts"],
      "@/lib/project-health-sources": ["./lib/integrations/status/project-health-sources.ts"],
      "@/lib/rss-reader-server": ["./lib/integrations/content/rss-reader-server.ts"],
      "@/lib/service-favicons": ["./lib/integrations/status/service-favicons.ts"],
      "@/lib/status-page-links": ["./lib/integrations/status/status-page-links.ts"],
      "@/lib/features": ["./lib/extensions/runtime/features.ts"],
      "@/lib/features-init": ["./lib/extensions/runtime/features-init.ts"],
      "@/lib/integrations-init": ["./lib/extensions/runtime/integrations-init.ts"],
      "@/lib/plugins-init": ["./lib/extensions/runtime/plugins-init.ts"],
      "@/lib/transpile-packages": ["./lib/extensions/runtime/transpile-packages.ts"],
      "@/lib/widgets-init": ["./lib/extensions/runtime/widgets-init.ts"],
      "@/lib/env": ["./lib/system/runtime/env.ts"],
      "@/lib/e2e": ["./lib/system/runtime/e2e.ts"],
      "@/lib/platform": ["./lib/system/runtime/platform.ts"],
      "@/lib/providers": ["./lib/system/runtime/providers.ts"],
      "@/lib/runtime-data-paths": ["./lib/system/runtime/runtime-data-paths.ts"],
      "@/lib/client-debug": ["./lib/system/ui/client-debug.ts"],
      "@/lib/demo-data": ["./lib/system/ui/demo-data.ts"],
      "@/lib/dev-extensions-init": ["./lib/system/ui/dev-extensions-init.ts"],
      "@/lib/dialog": ["./lib/system/ui/dialog.ts"],
      "@/lib/tauri-updater": ["./lib/system/ui/tauri-updater.ts"],
      "@/lib/clipboard": ["./lib/system/ui/clipboard.ts"],
      "@/lib/radarboard-config": ["./lib/system/config/radarboard-config.ts"],
      "@/lib/plugin-token": ["./lib/system/config/plugin-token.ts"],
      "@/lib/debug-events": ["./lib/system/events/debug-events.ts"],
      "@/lib/event-gateway": ["./lib/system/events/event-gateway.ts"],
      "@/lib/health-tracker": ["./lib/system/events/health-tracker.ts"],
      "@/lib/offline-sync": ["./lib/system/polling/offline-sync.ts"],
      "@/lib/polling-config": ["./lib/system/polling/polling-config.ts"],
      "@/lib/polling-settings": ["./lib/system/polling/polling-settings.ts"],
      "@/lib/workflow-scheduler-runtime": ["./lib/system/polling/workflow-scheduler-runtime.ts"],
      "@/lib/circuit-breaker": ["./lib/utils/control/circuit-breaker.ts"],
      "@/lib/generate-secret": ["./lib/utils/core/generate-secret.ts"],
      "@/lib/outbound-rate-limit": ["./lib/utils/control/outbound-rate-limit.ts"],
      "@/lib/rate-limit": ["./lib/utils/control/rate-limit.ts"],
      "@/lib/retry": ["./lib/utils/control/retry.ts"],
      "@/lib/session-mutex": ["./lib/utils/control/session-mutex.ts"],
      "@/lib/shutdown": ["./lib/utils/control/shutdown.ts"],
      "@/lib/layout-utils": ["./lib/layout/runtime/layout-utils.ts"],
      "@/lib/project-routes": ["./lib/layout/runtime/project-routes.ts"],
      "@/lib/template-editor": ["./lib/layout/runtime/template-editor.ts"],
      "@/lib/license": ["./lib/licensing/license.ts"],
      "@/lib/license-crypto": ["./lib/licensing/license-crypto.ts"],
      "@/lib/license-email": ["./lib/licensing/license-email.ts"],
      "@/lib/lemonsqueezy": ["./lib/licensing/lemonsqueezy.ts"],
      "@/lib/mcp-bridge": ["./lib/mcp/mcp-bridge.ts"],
      "@/lib/mcp-client": ["./lib/mcp/mcp-client.ts"],
      "@/lib/mcp-oauth": ["./lib/mcp/mcp-oauth.ts"],
      "@/lib/mcp-server-config": ["./lib/mcp/mcp-server-config.ts"],
      "@/lib/named-mcp-client": ["./lib/mcp/named-mcp-client.ts"],
      "@/lib/notification-glob": ["./lib/notifications/notification-glob.ts"],
      "@/lib/notification-open-url": ["./lib/notifications/notification-open-url.ts"],
      "@/lib/notification-webhooks": ["./lib/notifications/notification-webhooks.ts"],
      "@/lib/notifications": ["./lib/notifications/notifications.ts"],
      "@/lib/oauth/*": ["./lib/auth/oauth/*"],
      "@/lib/ai-actions/*": [
        "./lib/ai-actions/*",
        "./lib/ai-actions/analysis/*",
        "./lib/ai-actions/extensions/*",
        "./lib/ai-actions/issues/*",
        "./lib/ai-actions/memory/*",
        "./lib/ai-actions/reports/*"
      ],
      "@/lib/*": [
        "./lib/*",
        "./lib/assistant/*",
        "./lib/assistant/core/*",
        "./lib/assistant/integration/*",
        "./lib/assistant/knowledge/*",
        "./lib/auth/*",
        "./lib/auth/oauth/*",
        "./lib/extensions/*",
        "./lib/extensions/runtime/*",
        "./lib/integrations/*",
        "./lib/integrations/config/*",
        "./lib/integrations/content/*",
        "./lib/integrations/status/*",
        "./lib/layout/*",
        "./lib/layout/runtime/*",
        "./lib/licensing/*",
        "./lib/mcp/*",
        "./lib/notifications/*",
        "./lib/shortcuts/*",
        "./lib/system/*",
        "./lib/system/config/*",
        "./lib/system/events/*",
        "./lib/system/polling/*",
        "./lib/system/runtime/*",
        "./lib/system/ui/*",
        "./lib/utils/*",
        "./lib/utils/core/*",
        "./lib/utils/control/*",
        "./lib/extension-installer/*"
      ],
      "@/*": ["./*"],
      "@radarboard/types/*": ["../../packages/types/src/*"],
      "@radarboard/storybook-preview": ["../storybook/.storybook/preview.tsx"],
      "@radarboard/storybook-scaffold": ["../storybook/src/story-scaffold.tsx"],
      "@radarboard/storybook-mocks/use-dashboard": [
        "../storybook/src/mocks/hooks/use-dashboard.ts"
      ],
      "@storybook/nextjs-vite": ["../storybook/node_modules/@storybook/nextjs-vite"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}
