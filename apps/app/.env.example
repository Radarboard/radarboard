# ===========================================
# Radarboard - Environment Variables
# ===========================================
# Use 1Password env sync to populate

# --- ChatGPT MCP Connector (OpenAI Apps SDK) ---
# Register your app at: https://platform.openai.com/apps-manage
# Set your MCP endpoint to: {NEXT_PUBLIC_APP_URL}/api/mcp
# Allowed redirect URIs in your app registration:
#   https://chatgpt.com/connector/oauth/{callback_id}  (production)
#   https://platform.openai.com/apps-manage/oauth       (review / testing)
#
# Public URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.com
# Secret used to sign MCP access tokens — generate with: openssl rand -hex 32
RADARBOARD_API_SECRET=

# --- RevenueCat ---
# Get from: https://app.revenuecat.com > Project > API Keys
REVENUECAT_API_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=

# --- OpenPanel (single root client for all projects) ---
# Get from: OpenPanel dashboard > Settings > Clients > Create Root client
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# --- OpenPanel Client-Side Tracking ---
# Public client ID for browser-side analytics (pageviews, events)
# Get from: OpenPanel dashboard > Settings > Clients
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# --- Open Collective ---
# Personal token from: https://opencollective.com/{account}/admin/for-developers
# Required scope: account
OPENCOLLECTIVE_API_TOKEN=

# --- Google Search Console OAuth Broker ---
# Enable "Search Console API" in your Google Cloud project.
# Register this redirect URI in Google Cloud:
#   https://app.radarboard.app/api/auth/google/callback
# Local/dev apps use the hosted broker and should not store Google client secrets.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
RADARBOARD_OAUTH_BROKER_URL=https://app.radarboard.app

# --- Linear ---
# Personal API key from: https://linear.app/settings/api
LINEAR_API_KEY=

# --- GitHub ---
# Personal access token (classic) from: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public repos only)
GITHUB_TOKEN=

# --- Resend ---
# API key from: https://resend.com/api-keys
# From email must be a verified domain in Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# --- Vercel ---
# Token from: https://vercel.com/account/tokens
# Team ID from: https://vercel.com/teams/{team}/settings
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Sentry ---
# Auth token from: https://sentry.io/settings/auth-tokens/
# Required scopes: project:read, event:read, org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=

# --- App Store Connect ---
# API key from: https://appstoreconnect.apple.com/access/api
# Private key is the .p8 file content (replace newlines with \n)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=

# --- BetterStack (Uptime) ---
# API token from: https://betterstack.com/docs/uptime/api/getting-started/
BETTERSTACK_API_TOKEN=

# --- Lemon Squeezy (Billing) ---
# API key from: https://app.lemonsqueezy.com/settings/api
# Webhook signing secret from: https://app.lemonsqueezy.com/settings/webhooks
# Store ID and Pro Variant ID from your Lemon Squeezy dashboard
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# The variant ID of your Pro plan product (used to map purchases to plan tier)
LEMONSQUEEZY_PRO_VARIANT_ID=
# Checkout URL for the Pro plan (your Lemon Squeezy checkout link)
NEXT_PUBLIC_LEMONSQUEEZY_PRO_CHECKOUT_URL=

# --- License Key Signing (Ed25519) ---
# Generate a keypair: node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log(Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
# Private key (server-only, signs license keys):
# RADARBOARD_LICENSE_PRIVATE_KEY=
# Public key (embedded in app, verifies license keys):
# NEXT_PUBLIC_RADARBOARD_LICENSE_PUBLIC_KEY=

# --- Plan Tier ---
# Which plan to activate: free (default), pro, enterprise
# For self-hosted / desktop: set to "enterprise" to unlock all features
# For SaaS: leave unset — plan is read from the user's subscription in DB
# NEXT_PUBLIC_RADARBOARD_PLAN=free

# --- Database Provider ---
# Which database backend to use: sqlite (default), supabase, planetscale, turso
# SQLite requires no additional config. Other providers need their own env vars below.
DATABASE_PROVIDER=sqlite

# --- Turso (Settings persistence) ---
# Database URL from: https://turso.tech/app
# Auth token from: turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Backup Cron ---
# Secret token to authenticate backup cron requests
# Generate with: openssl rand -hex 32
BACKUP_SECRET=
# Backup interval in milliseconds (default: 900000 = 15 minutes)
# BACKUP_INTERVAL_MS=900000
# Base URL for the backup cron to call (default: http://localhost:3000)
# BACKUP_CRON_URL=http://localhost:3000

# --- Webhook Relay (optional) ---
# See docs: apps/docs/developer-guide/webhook-relay.mdx
# The relay URL is configured in Dashboard Settings > Integrations, not here.
# Shared secret — must match RELAY_POLL_SECRET on the relay. Generate with: openssl rand -hex 32
# RELAY_POLL_SECRET=
