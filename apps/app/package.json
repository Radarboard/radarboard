  "name": "@radarboard/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORTLESS_HTTPS=1 devlogs -- portless radarboard next dev --turbopack",
    "dev:desktop": "next dev --turbopack --port 1355 --hostname 127.0.0.1",
    "dev:e2e": "NEXT_PUBLIC_RADARBOARD_E2E=1 RADARBOARD_E2E=1 RADARBOARD_DATA_DIR=.radarboard-e2e next dev --port 1365 --hostname 127.0.0.1",
    "build:e2e": "NEXT_PUBLIC_RADARBOARD_E2E=1 RADARBOARD_E2E=1 RADARBOARD_DATA_DIR=.radarboard-e2e next build",
    "build": "next build",
    "start:e2e": "NEXT_PUBLIC_RADARBOARD_E2E=1 RADARBOARD_E2E=1 RADARBOARD_DATA_DIR=.radarboard-e2e next start --port 1365 --hostname 127.0.0.1",
    "serve:e2e": "NEXT_PUBLIC_RADARBOARD_E2E=1 RADARBOARD_E2E=1 RADARBOARD_DATA_DIR=.radarboard-e2e next build && NEXT_PUBLIC_RADARBOARD_E2E=1 RADARBOARD_E2E=1 RADARBOARD_DATA_DIR=.radarboard-e2e next start --port 1365 --hostname 127.0.0.1",
    "start": "next start",
    "lint": "biome check . && pnpm --dir ../.. check:route-error-responses",
    "lint:fix": "biome check --write . && pnpm --dir ../.. check:route-error-responses",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "backup:cron": "tsx scripts/backup-cron.ts",
    "backup:now": "tsx scripts/backup-cron.ts --once",
    "github-stars:backfill": "tsx scripts/backfill-github-stars.ts"
