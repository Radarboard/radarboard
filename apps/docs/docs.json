{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Radarboard",
  "colors": {
    "primary": "#2563eb",
    "light": "#2563eb",
    "dark": "#1d4ed8"
  },
  "fonts": {
    "family": "Geist",
    "familyMono": "Geist Mono"
  },
  "modeToggle": {
    "default": "dark"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "min-light",
        "dark": "min-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://docs.radarboard.app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Introduction",
            "pages": ["index", "quickstart", "desktop-beta"]
          }
        ]
      },
      {
        "tab": "Services",
        "icon": "plug",
        "groups": [
          {
            "group": "Overview",
            "pages": ["services/overview"]
          },
          {
            "group": "Revenue & Monetization",
            "pages": [
              "services/revenuecat",
              "services/open-collective",
              "services/app-store-connect"
            ]
          },
          {
            "group": "Analytics & SEO",
            "pages": ["services/openpanel", "services/google-search-console"]
          },
          {
            "group": "Development & Shipping",
            "pages": ["services/github", "services/linear", "services/vercel"]
          },
          {
            "group": "Monitoring & Alerts",
            "pages": ["services/sentry", "services/betterstack", "services/resend"]
          }
        ]
      },
      {
        "tab": "Widgets",
        "icon": "grid-2",
        "groups": [
          {
            "group": "Overview",
            "pages": ["widgets/overview"]
          },
          {
            "group": "Grid Widgets",
            "pages": [
              "widgets/revenue",
              "widgets/sponsorship",
              "widgets/shipping",
              "widgets/analytics",
              "widgets/seo-performance",
              "widgets/service-monitor",
              "widgets/github-stars",
              "widgets/downloads"
            ]
          },
          {
            "group": "Chrome Components",
            "pages": ["widgets/kpi-strip", "widgets/bottom-ticker"]
          }
        ]
      },
      {
        "tab": "MCP Servers",
        "icon": "server",
        "groups": [
          {
            "group": "Overview",
            "pages": ["mcp-servers/overview"]
          },
          {
            "group": "Available Servers",
            "pages": [
              "mcp-servers/radarboard",
              "mcp-servers/revenuecat",
              "mcp-servers/openpanel",
              "mcp-servers/chatgpt"
            ]
          }
        ]
      },
      {
        "tab": "Developer Guide",
        "icon": "code",
        "groups": [
